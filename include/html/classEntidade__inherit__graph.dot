  Node1 [id="Node000001",label="Entidade",height=0.2,width=0.4,color="gray40", fillcolor="grey60", style="filled", fontcolor="black",tooltip="Classe abstrata para representar as entidades."];
  Node1 -> Node2 [id="edge1_Node000001_Node000002",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node2 [id="Node000002",label="Inimigo",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$classInimigo.html",tooltip="Entidade que irá contra o personagem principal Classe que herda de entidade, sendo o inimigo do jogo ..."];
